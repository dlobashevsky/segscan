# Directory with the GGUF files, mounted read-only.
MODELS_DIR=/srv/models

# A model split into parts (...-00001-of-00002.gguf, ...-00002-of-00002.gguf):
# name the first part; llama.cpp loads the rest from the same directory.
MODEL_FILE=Qwen3.6-35B-A3B-Q4_K_M-00001-of-00002.gguf

# Generation is limited by memory bandwidth: physical cores, not threads.
# Prompt processing is compute-bound: all threads. E-2386G and i7-8700: 6 and 12.
THREADS=6
THREADS_BATCH=12

# Requests processed at once; give llm-review the same -j. On a CPU more slots
# barely help: prompt processing already uses every core.
SLOTS=2

# Total context, shared by the slots (8192 / 2 = 4096 tokens each). Enough for
# the instruction, a few dozen examples and one finding.
CTX=8192

# Hybrid models (recurrent layers next to attention) reuse a cached prompt
# prefix only from a checkpoint. If llm-review reports almost the whole prompt
# as "new prompt tokens per finding", the instruction is processed again for
# every finding: try 0 here (a checkpoint after every prompt; costs RAM).
CHECKPOINT_MIN_STEP=8192

PORT=8080

# Pin a llama.cpp build (e.g. server-b7000) for reproducible scores.
LLAMA_IMAGE_TAG=server
